# === CONFIGURACIÓN DE ENTORNO ===
ENVIRONMENT=development

# === RUTAS DE DATOS (ajustar según tu sistema) ===
# Ejemplo para Windows (ajusta la ruta según tu usuario):
DATA_SOURCES_DIR=C:/Users/TU_USUARIO/Documents/Proyect_Coder/gestion_de_stock/data_sources
OUTPUTS_DIR=C:/Users/TU_USUARIO/Documents/Proyect_Coder/gestion_de_stock/outputs
REPORTS_DIR=C:/Users/TU_USUARIO/Documents/Proyect_Coder/gestion_de_stock/outputs/reports
PROCESAMIENTO_DIR=C:/Users/TU_USUARIO/Documents/Proyect_Coder/gestion_de_stock/procesamiento

# === API CONFIGURACIÓN ===
API_TIMEOUT_BASE=30
API_MAX_RETRIES=3
STOCK_API_URL="http://appweb.cipsa.com.pe:8054/AlmacenStock/DownLoadFiles?value={%22 %22:%22%22,%22parametroX1%22:%220%22}"

# === CONFIGURACIÓN DE ENTREGA DUAL ===
ENABLE_DUAL_DELIVERY=true
GDRIVE_ROOT=${USERPROFILE}/Google Drive
GDRIVE_PROJECT_FOLDER=Gestion_360
GDRIVE_SALIDA_PATH=${GDRIVE_ROOT}/${GDRIVE_PROJECT_FOLDER}/360_salida
GDRIVE_BASE_INICIO_PATH=${GDRIVE_ROOT}/${GDRIVE_PROJECT_FOLDER}/360_base_inicio

# === CONFIGURACIÓN DE FALLBACK ===
ENABLE_FALLBACK=true
FALLBACK_DAYS_BACK=7

# === CONFIGURACIÓN DE LOGGING ===
LOG_LEVEL=INFO
LOG_TO_FILE=true

# === CONFIGURACIÓN DE USUARIO (para compatibilidad) ===
USER_NAME=${USER:-$(whoami)}
DESKTOP_PATH=${USERPROFILE}/Desktop

# === NOTAS DE CONFIGURACIÓN ===
# 1. Copie este archivo como .env y ajuste las rutas según su entorno
# 2. Para producción, cambie ENVIRONMENT=production
# 3. Asegúrese de que las rutas de Google Drive existan
# 4. El sistema es portable y funciona en cualquier directorio